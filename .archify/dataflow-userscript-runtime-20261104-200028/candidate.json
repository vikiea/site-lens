  "cards": [
    {
      "dot": "rose",
      "title": "信任边界",
      "items": [
        "摘要 digest 同时覆盖源码、@require 依赖与 @resource 资源的 SHA-256",
        "依赖与资源在 enable 时下载并钉住，之后每轮不符即视为被改写",
        "public 网络模式需要逐脚本确认，legacy 摘要按声明式模式就地升级"
      ]
    },
    {
      "dot": "amber",
      "title": "declared / public 网络模式",
      "items": [
        "declared 模式只放行 metadata.connect 里声明的域名",
        "public 模式放行全部域名，但必须 public_confirmed 才算有效确认",
        "连接域在 NativeHosts.onGmRequest 里按 xhr 请求逐个校验"
      ]
    },
    {
      "dot": "violet",
      "title": "备份不含未确认状态",
      "items": [
        "saveScript 每次写入都把 enabled 与 approved_digest 清零",
        "脚本被禁用或确认被清空后，备份只能恢复源码，不会恢复授权",
        "@grant none 的脚本进页面世界，且没有 lensBridge 可调用"
      ]
    },
    {
      "dot": "cyan",
      "title": "自动关闭与回写",
      "items": [
        "完整性闸门失配时禁用脚本并记录「确认或依赖完整性已失效，自动关闭」",
        "不支持 @grant、unsafeWindow 与 GM 特权混用都在元数据解析阶段报错",
        "GM 值写回经 lensBridge 进入 onGmRequest，再按脚本串行写入本地数据库"
      ]
    }
  ]
