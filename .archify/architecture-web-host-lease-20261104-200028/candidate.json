  "cards": [
    {
      "dot": "cyan",
      "title": "租约规则",
      "items": [
        "prepareNavigation 先撤销旧租约，再用 ticket=新 generation 发起准备",
        "仅 App 发起的导航可跟随服务端重定向，最多 5 跳（MAX_ENTRY_REDIRECTS）",
        "历史导航走 prepareHistoryNavigation：预授权并保留 expectedUrl，避免后退误报 scriptsSuspended",
        "事件 generation 小于当前租约即被丢弃，过期回包无法改写标签状态"
      ]
    },
    {
      "dot": "violet",
      "title": "世界与授权",
      "items": [
        "特权脚本进入每脚本隔离世界，注入前缀 const __lensBridgeToken = \"…\";",
        "@grant none 与 unsafeWindow 进入页面世界，没有特权桥",
        "lensBridge 按每文档 token、origin、@match 与 generation 校验后才到 Dart",
        "未认证的 WebMessage 不会进入 onGmRequest"
      ]
    },
    {
      "dot": "emerald",
      "title": "页面遥测",
      "items": [
        "media_lifecycle.js 由 BrowserMediaController 注入页面世界，仅上报候选与播放证据",
        "该脚本没有导航、网络、存储或用户脚本权限，消息超过 4096 字节即丢弃",
        "媒体候选经宿主事件 mediaCandidate / mediaPlaybackEvidence 回传，随租约失效清空"
      ]
    }
  ]
}