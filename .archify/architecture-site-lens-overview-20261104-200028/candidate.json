  "cards": [
    {
      "dot": "cyan",
      "title": "本地优先与 fail-closed",
      "items": [
        "站点、候选、脚本与任务全部落在本地 SQLite，无服务端、无遥测",
        "网络与脚本能力默认关闭，需显式确认后才放行"
      ]
    },
    {
      "dot": "amber",
      "title": "容量与预算",
      "items": [
        "最多 8 个标签页、8 个并发初筛、每候选 5 秒合计预算",
        "默认只验证前 3 个不同落点，全部模式才放开"
      ]
    },
    {
      "dot": "rose",
      "title": "数据边界",
      "items": [
        "Cookie、Web 存储、未确认脚本状态不进入业务备份",
        "授权刷新只回传状态与摘要，凭据不跨 Dart 通道"
      ]
    }
  ]
