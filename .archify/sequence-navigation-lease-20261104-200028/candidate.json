  "cards": [
    {
      "dot": "cyan",
      "title": "租约生命周期",
      "items": [
        "prepareNavigation 先 revoke()，ticket 取新 generation，再由 install() 写 expectedUrl、leasedOrigin 与 accepting",
        "prepareHistoryNavigation 预授权前进后退，保留 expectedUrl，另起历史超时",
        "事件 generation 小于当前值直接丢弃，等于新值才重置取消令牌、菜单与媒体证据"
      ]
    },
    {
      "dot": "amber",
      "title": "5 跳上限",
      "items": [
        "只有 App 发起且 entryArmed 的同源入口跳转才累加 entryHops",
        "entryHops < MAX_ENTRY_REDIRECTS（5）才更新 expectedUrl 与 leasedOrigin",
        "跨源跳转立即 revoke 并发出 scriptsSuspended"
      ]
    },
    {
      "dot": "violet",
      "title": "每文档 token",
      "items": [
        "install() 为每个特权脚本生成 UUID token，拼成 const __lensBridgeToken = ...; 前缀",
        "lensBridge 监听器按世界找 binding，校验 token、来源与版本，未认证消息不进 Dart"
      ]
    },
    {
      "dot": "rose",
      "title": "事件按 generation 丢弃",
      "items": [
        "NativeHosts.onEvent 丢弃 event.generation < session.generation 的过期事件",
        "generation 变化时清理 _aborted、取消令牌、菜单、媒体候选与播放证据",
        "Navigation policy rejected 与 Navigation setup failed 都变成 networkError"
      ]
    }
  ]
