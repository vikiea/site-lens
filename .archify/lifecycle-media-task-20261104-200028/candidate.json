  "cards": [
    {
      "dot": "amber",
      "title": "迁移白名单",
      "items": [
        "_transition 按当前状态取允许集合，集合外的迁移抛 StateError。",
        "queued 只允许 downloading / cancelled / failed。",
        "completed 只允许 failed / playable / cancelled；playable 只允许 cancelled / failed。",
        "转入 downloading 时清空 errorCode 与 errorReason。"
      ]
    },
    {
      "dot": "emerald",
      "title": "终态会重启",
      "items": [
        "cancelled 与 failed 都允许回到 downloading，重试沿用同一任务行。",
        "批量重试针对 failed / cancelled / paused / reauthorize。",
        "failed 与 cancelled 之间也可以互相迁移。"
      ]
    },
    {
      "dot": "violet",
      "title": "取消与失败不是绝对终态",
      "items": [
        "需要重新授权由授权失败触发，刷新后只重试一次。",
        "网络变化会恢复 paused 任务并重建原生传输。",
        "缓存缺失把 completed / playable 降级为 failed(cacheMissing)。"
      ]
    }
  ]
