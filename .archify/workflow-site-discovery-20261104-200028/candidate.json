  "cards": [
    {
      "dot": "cyan",
      "title": "精确限制",
      "items": [
        "HTTP 初筛并发 maxConcurrentProbes = 8，每候选 candidateDeadline = 5s",
        "默认只验证前 3 个不同落点，且串行执行，便于横向比较耗时",
        "all=true 时验证全部不同落点，并发仍不超过 8",
        "每个候选的 HTTP 初筛与 DOM 验证合计共享 5 秒预算，超时记为 timeout"
      ]
    },
    {
      "dot": "violet",
      "title": "ProbeStatus 十种取值",
      "items": [
        "reachable（初筛可达 · 未验证）、ready（首页已就绪）",
        "unavailable、timeout、offline、certificateError",
        "challenge、interactionRequired、unsupported、cancelled"
      ]
    },
    {
      "dot": "amber",
      "title": "人为决策",
      "items": [
        "检测完成后由用户选择落点，绝不自动跳转",
        "通知原文：首页已就绪 N 个不同落点；仅初筛前三个不同落点。HTTP 可达不代表首页可用。",
        "历史 ready 不等于当前已验证：只有本轮 round 内的读数进入推荐",
        "取消检测会递增 round 并清空推荐；保存失败以 notice 附带体现，不阻断推荐"
      ]
    }
  ]
