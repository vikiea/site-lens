# Copy this file to .env.local for per-project development defaults.
# .env.local is ignored and should never contain secrets or a full personal PATH.
# Process environment variables and command-line Make variables override this file.

# Flutter SDK: set one of these when automatic discovery is insufficient.
# FLUTTER_ROOT=/absolute/path/to/flutter
# FLUTTER_BIN_DIR=/absolute/path/to/flutter/bin

# Android SDK: set one when it is outside the standard macOS locations.
# ANDROID_HOME=/absolute/path/to/android-sdk
# ANDROID_SDK_ROOT=/absolute/path/to/android-sdk

# JDK 21.
# JAVA_HOME=/absolute/path/to/jdk-21

# Optional emulator defaults. Keep DEVICE out of this file when it identifies a personal device.
# EMULATOR_AVD=sl_g37
# AVD_NAME=sl_g37
# AVD_IMAGE=system-images;android-36;google_apis;arm64-v8a

# Optional path to external release signing properties. Never put credentials here.
# SITE_LENS_SIGNING_PROPERTIES=/absolute/path/to/signing.properties

# Optional real-site acceptance only, passed to debug integration tests.
# Comma-separated HTTPS entry URLs; leave empty for deterministic fixture tests.
# SITE_LENS_TEST_SITES=https://example.org/,https://example.net/entry/
